# ============================================================
# Smart Poultry Farm Management System - Environment Variables
# ============================================================

# Application
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=smart_poultry_super_secret_jwt_key_2026_dev

# Database Configuration (MySQL 8)
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_poultry
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# JWT Authentication
JWT_SECRET_KEY=smart_poultry_jwt_secret_token_secure_key_2026
JWT_ACCESS_TOKEN_EXPIRES_HOURS=72

# SMS Gateway Configuration
# Options for SMS_PROVIDER: 'mock' (default for dev), 'fast2sms', 'twilio', 'msg91'
SMS_PROVIDER=mock
SMS_API_KEY=your_sms_gateway_api_key_here
SMS_SENDER_ID=SMTPTR
SMS_TEMPLATE_ID=your_dlt_or_otp_template_id

# Twilio Specific (if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# OTP Security Policies
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
