# Development Environment
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=smart_poultry_super_secret_jwt_key_2026_dev

# Database Configuration (MySQL 8)
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_poultry
DB_USER=root
DB_PASSWORD=root

# JWT Authentication
JWT_SECRET_KEY=smart_poultry_jwt_secret_token_secure_key_2026
JWT_ACCESS_TOKEN_EXPIRES_HOURS=72

# SMS Gateway Configuration
# Set SMS_PROVIDER to 'fast2sms' or 'msg91' for real Indian mobile SMS delivery
SMS_PROVIDER=fast2sms
SMS_API_KEY=your_real_sms_api_key_here
SMS_SENDER_ID=POULTR
SMS_TEMPLATE_ID=
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
